# This checkout is a data-disk workspace.  The APC branch intentionally
# tracks only the current MMaDA/VCHD implementation and its VLind runner.
/*
!/.gitignore
!/README.md
!/MMaDA_DCD_cloud_bundle_20260711/
!/VLind-Bench/
!/LaViDa/

# Keep the authoritative MMaDA tree, not bundle-side artifacts.
/MMaDA_DCD_cloud_bundle_20260711/*
!/MMaDA_DCD_cloud_bundle_20260711/MMaDA/

# VLind is evaluation glue only; datasets and outputs stay external.
/VLind-Bench/*
!/VLind-Bench/eval/
/VLind-Bench/eval/*
!/VLind-Bench/eval/mmada_eval.py
!/VLind-Bench/eval/score_pipeline.py
!/VLind-Bench/scripts/
/VLind-Bench/scripts/*
!/VLind-Bench/scripts/make_mmbench_two_cycle.py
!/VLind-Bench/scripts/run_llavabench_thinking_infer.sh
!/VLind-Bench/scripts/run_mmbench_thinking_chain.sh
!/VLind-Bench/scripts/run_mmbench_4way_2cycle.sh
!/VLind-Bench/scripts/run_mmada_vcd_m3cot.sh
!/VLind-Bench/scripts/run_mmada_vcd_matrix.sh
!/VLind-Bench/eval/mmada_m3cot_eval.py

# Python and test caches.
**/__pycache__/
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
*.py[cod]

# Local environments and package-manager artifacts.
**/.venv/
**/venv/
**/env/
**/node_modules/
**/*.egg-info/

# Nested repository backups must never become vendored history.
**/.git/
**/.git.bak/
**/.git.old/

# Generated experiment artifacts.
**/.cache/
**/outputs/
**/logs/
**/results/
**/runs/
**/wandb/
**/checkpoints/
**/attention_*/
**/LMUData/
**/training/questions.json
*.log

# Model weights, tensor dumps, datasets, and archives.
*.safetensors
*.ckpt
*.pt
*.pth
*.bin
*.npy
*.npz
*.zip
*.tar
*.tar.gz

# LaViDa: keep source/eval glue; drop weights and local run artifacts.
/LaViDa/lavida-ckpts/
/LaViDa/eval/logs/
/LaViDa/images/
/LaViDa/**/__pycache__/
/LaViDa/**/.cache/

# Reported benchmark artifacts (explicit allow; general logs/ still ignored).
!/LaViDa/eval/reported_results/
!/LaViDa/eval/reported_results/**

